APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Optional asset CDN/root. If assets 404, set this (and APP_URL) to include /public
# when the host document root is the project folder instead of public/.
# ASSET_URL=
# Web installer lock (created by /install or `php artisan app:install --mark-installed`).
# APP_INSTALL_LOCK=storage/app/installed.lock
# Comma-separated live hosts (wildcards allowed, e.g. *.example.com): never show local OTP,
# block migrate:fresh / db:wipe.
APP_LIVE_HOSTS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=1080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail stays on "log" after install until SMTP is configured here; login OTP can only be
# enabled in Settings > Company settings after a test email succeeds.
# Microsoft 365: MAIL_USERNAME and MAIL_FROM_ADDRESS must be the same mailbox.
# Send As another address (e.g. no-reply@) is denied unless that mailbox has Send As permission.
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME="mailbox@example.com"
MAIL_PASSWORD="your-mailbox-or-app-password"
MAIL_FROM_ADDRESS="mailbox@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Fallback only: MAIL_MAILER=sendmail
# MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -t -i"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
